generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model Environment {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users               UserEnvironment[]
  productTypes        ProductType[]
  movementTypes       MovementType[]
  productStatuses     ProductStatus[]
  requisitionStatuses RequisitionStatus[]
  costCenters         CostCenter[]
  assetCategories     AssetCategory[]
  providers           Provider[]

  products     Product[]
  assets       Asset[]
  movements    Movement[]
  requisitions Requisition[]
}



model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  isActive     Boolean  @default(true)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  environments  UserEnvironment[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  assets        Asset[]
  movements     Movement[]
  requisitions  Requisition[]      @relation("RequesterRequisitions")
  authorizedRequisitions Requisition[] @relation("AuthorizerRequisitions")
}

enum Role {
  ADMIN
  ALMACEN
  AUTORIZADOR
  COMPRAS
  USUARIO
}

model UserEnvironment {
  id            String   @id @default(uuid())
  userId        String
  environmentId String
  role          Role
  isActive      Boolean  @default(true)
  revokedAt     DateTime?

  user        User        @relation(fields: [userId], references: [id])
  environment Environment @relation(fields: [environmentId], references: [id])

  @@unique([userId, environmentId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  targetType String
  targetId   String
  action     String
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])
}



model ProductType {
  id            String   @id @default(uuid())
  name          String
  description   String?
  environmentId String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  environment Environment @relation(fields: [environmentId], references: [id])
  products    Product[]

  @@unique([name, environmentId])
}

enum MovementDirection {
  IN
  OUT
}

model MovementType {
  id            String            @id @default(uuid())
  name          String
  direction     MovementDirection
  environmentId String
  isActive      Boolean           @default(true)

  environment Environment @relation(fields: [environmentId], references: [id])
  movements   Movement[]

  @@unique([name, environmentId])
}

model ProductStatus {
  id            String  @id @default(uuid())
  name          String
  environmentId String
  isActive      Boolean @default(true)

  environment Environment @relation(fields: [environmentId], references: [id])
  products    Product[]
  assets      Asset[]

  @@unique([name, environmentId])
}

model RequisitionStatus {
  id            String  @id @default(uuid())
  name          String
  environmentId String
  isActive      Boolean @default(true)

  environment Environment @relation(fields: [environmentId], references: [id])
  requisitions Requisition[]

  @@unique([name, environmentId])
}

model CostCenter {
  id            String  @id @default(uuid())
  name          String
  code          String?
  environmentId String
  isActive      Boolean @default(true)

  environment  Environment    @relation(fields: [environmentId], references: [id])
  movements    Movement[]
  requisitions Requisition[]

  @@unique([name, environmentId])
}

model AssetCategory {
  id            String  @id @default(uuid())
  name          String
  environmentId String
  isActive      Boolean @default(true)

  environment Environment @relation(fields: [environmentId], references: [id])
  assets      Asset[]

  @@unique([name, environmentId])
}

model Provider {
  id            String @id @default(uuid())
  environmentId String

  nombre    String
  contacto  String?
  telefono  String?
  email     String?
  direccion String?
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())

  environment Environment @relation(fields: [environmentId], references: [id])
  products    Product[]

  @@unique([nombre, environmentId])
}



model Product {
  id            String @id @default(uuid())
  environmentId String

  typeId      String
  statusId    String
  proveedorId String?

  marca          String
  modelo         String?
  especificacion String?
  imagenUrl      String?
  
  // Campos restaurados
  sku  String?
  unit String?

  precioUnitario Decimal @db.Decimal(10, 2)
  stockActual    Int

  isActive Boolean @default(true)

  fechaUltimaCompra DateTime?
  createdAt         DateTime @default(now())

  environment Environment   @relation(fields: [environmentId], references: [id])
  type        ProductType   @relation(fields: [typeId], references: [id])
  status      ProductStatus @relation(fields: [statusId], references: [id])
  proveedor   Provider?     @relation(fields: [proveedorId], references: [id])

  movementDetails     MovementDetail[]
  requisitionDetails  RequisitionDetail[]
}

model Asset {
  id            String @id @default(uuid())
  environmentId String

  categoryId    String
  statusId      String
  responsableId String

  marca       String
  modelo      String?
  numeroSerie String?
  ubicacion   String?
  imagenUrl   String?

  stockActual Int?
  createdAt   DateTime @default(now())

  environment Environment   @relation(fields: [environmentId], references: [id])
  category    AssetCategory @relation(fields: [categoryId], references: [id])
  status      ProductStatus @relation(fields: [statusId], references: [id])
  responsable User          @relation(fields: [responsableId], references: [id])
}


model Movement {
  id            String   @id @default(uuid())
  environmentId String

  typeId        String
  responsibleId String
  costCenterId  String?

  observations String?
  createdAt    DateTime @default(now())

  environment Environment  @relation(fields: [environmentId], references: [id])
  type        MovementType @relation(fields: [typeId], references: [id])
  responsible User         @relation(fields: [responsibleId], references: [id])
  costCenter  CostCenter?  @relation(fields: [costCenterId], references: [id])

  details MovementDetail[]

  @@index([environmentId])
  @@index([createdAt])
}

model MovementDetail {
  id         String @id @default(uuid())
  movementId String
  productId  String

  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)
  observations String?

  movement Movement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([movementId])
  @@index([productId])
}



model Requisition {
  id            String   @id @default(uuid())
  environmentId String

  // Campos restaurados
  folio         String   @unique
  solicitorId   String
  solicitorName String
  destinationId String
  authorizerId  String?
  
  requesterId String
  statusId    String

  observations String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  environment Environment       @relation(fields: [environmentId], references: [id])
  requester   User              @relation("RequesterRequisitions", fields: [requesterId], references: [id])
  status      RequisitionStatus @relation(fields: [statusId], references: [id])
  destination CostCenter        @relation(fields: [destinationId], references: [id])
  authorizer  User?             @relation("AuthorizerRequisitions", fields: [authorizerId], references: [id])

  details RequisitionDetail[]

  @@index([environmentId])
  @@index([createdAt])
}

model RequisitionDetail {
  id            String @id @default(uuid())
  requisitionId String
  productId     String

  quantity Int
  unitPrice Decimal @db.Decimal(10, 2)
  notes    String?

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@index([requisitionId])
  @@index([productId])
}